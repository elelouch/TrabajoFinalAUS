@using Microsoft.AspNetCore.Components.Authorization
@using Misstortas.Frontend.Services.Auth

@inject IAuthService AuthService

<AuthorizeView>
    <Authorized>
        <div class="auth-buttons">
            <span class="user-greeting">Hello, @context.User.Identity?.Name</span>
            <button class="btn btn-sm btn-outline-light" @onclick="SignOut">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Salir
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="auth-buttons">
            <NavLink class="btn btn-sm btn-outline-light" href="/signin">
                <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Ingreso
            </NavLink>
            <NavLink class="btn btn-sm btn-light" href="/signup">
                <span class="bi bi-person-plus" aria-hidden="true"></span> Registro
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private async Task SignOut()
    {
        await AuthService.SignOut();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}