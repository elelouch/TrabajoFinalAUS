@using Misstortas.Frontend.Services.Payments
@using Microsoft.AspNetCore.Components.Authorization
@using Misstortas.Frontend.Services.Products
@using Misstortas.Frontend.Services.Shared

@rendermode InteractiveServer

@inject IPaymentService PaymentService
@inject ISaleProductCartService CartService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="checkout-modal-overlay">
    <div class="checkout-modal">
        <div class="checkout-modal-header">
            <h4>Pago</h4>
            @if (!isProcessing && !showSuccessModal)
            {
                <button type="button" class="checkout-close-btn" @onclick="RequestClose" aria-label="Cerrar">
                    &times;
                </button>
            }
        </div>

        <AuthorizeView Context="authorizeContext">
            <NotAuthorized>
                <p class="alert alert-info">Por favor, iniciá sesión para completar tu compra.</p>
                <a href="/signin" class="btn cart-btn cart-btn-primary">Iniciar sesión para pagar</a>
            </NotAuthorized>
            <Authorized>
                <EditForm Model="payOrder" OnSubmit="HandlePayment">
                    <div class="mb-3">
                        <label class="form-label">Método de pago</label>
                        <select class="form-control checkout-select" @bind="selectedPaymentMethod">
                            <option value="">Seleccioná un método de pago</option>
                            <option value="0">Tarjeta de crédito</option>
                            <option value="1">Tarjeta de débito</option>
                            <option value="2">Efectivo</option>
                            <option value="3">UPI</option>
                        </select>
                    </div>

                    <button type="submit" class="btn cart-btn checkout-pay-btn mt-3" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <span>Completar pago</span>
                        }
                    </button>
                </EditForm>
            </Authorized>
        </AuthorizeView>

        @if (showSuccessModal)
        {
            <div class="checkout-success">
                <div class="checkout-success-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                    </svg>
                </div>
                <h4 class="mb-2">¡Pago exitoso!</h4>
                <p class="text-muted">Tu pedido fue realizado. Redirigiéndote a productos...</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public long OrderId { get; set; }

    [Parameter]
    public EventCallback OnPaymentSuccess { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string selectedPaymentMethod = "";
    private bool isProcessing = false;
    private string errorMessage = "";
    private bool showSuccessModal = false;
    private PayOrderDTO payOrder = new();

    private async Task RequestClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandlePayment()
    {
        isProcessing = true;
        errorMessage = "";

        if (string.IsNullOrEmpty(selectedPaymentMethod))
        {
            errorMessage = "Debés seleccionar un método de pago";
            isProcessing = false;
            ToastService.Warning(errorMessage);
            return;
        }

        try
        {
            var successfullCast = int.TryParse(selectedPaymentMethod, out int newval);
            payOrder.OrderId = OrderId;
            payOrder.PaymentMethod = successfullCast ? newval : 0;

            await PaymentService.PayOrderAsync(payOrder);
            await CartService.Clear();
            await OnPaymentSuccess.InvokeAsync();

            showSuccessModal = true;
            StateHasChanged();
            await Task.Delay(2500);  // Let the user read the message
            NavigationManager.NavigateTo("/products");
        }
        catch (HttpRequestException ex)
        {
            var msg = ex.Message ?? "El pago falló. Por favor, inténtalo de nuevo.";
            if(ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                ToastService.Warning($"El usuario no esta autorizado, solicite los permisos a su administrador. {msg}");
            }
            else
            {
                ToastService.Error($"Error inesperado. {msg}");
            }
            
        }
        finally
        {
            isProcessing = false;
        }
    }
}