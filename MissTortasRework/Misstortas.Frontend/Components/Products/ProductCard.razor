@using Misstortas.Frontend.Models
@using Microsoft.Extensions.Options
@using Misstortas.Frontend.Services.Files
@using Misstortas.Frontend.Services.Products
@using Misstortas.Frontend.Services.Shared

@inject IFileUrlBuilder FileUrlBuilder
@inject IOptions<APIHostsOptions> APIHostsOptions
@inject ISaleProductCartService Cart
@inject IToastService ToastService

@rendermode InteractiveServer

<div class="card shadow-sm rounded-3 h-100">

    @if (Product.FilePaths.Any())
    {
        <img src="@FileUrlBuilder.GetUploadUrl(Product.FilePaths.First())"
             class="card-img-top"
             alt="@Product.Name"
             style="height:220px; object-fit:cover;" />
    }
    else
    {
        <div class="d-flex justify-content-center align-items-center bg-light"
             style="height:220px;">
            <span class="text-muted">No image</span>
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Product.Name</h5>

        <div>
            <strong>Price:</strong>
            @Product.Price
        </div>

        @if (!string.IsNullOrWhiteSpace(ValidationMessage))
        {
            <div class="alert alert-danger py-2 mt-2">
                @ValidationMessage
            </div>
        }
        @if (Product.Quantity > 0)
        {
            <div class="mt-auto pt-3">
                <div class="input-group">

                    <button class="btn btn-outline-secondary"
                            @onclick="Decrease">
                        -
                    </button>

                    <InputNumber @bind-Value="QuantityDelta"
                                 class="form-control text-center"
                                 step="@Step"/>

                    <button class="btn btn-outline-primary"
                            @onclick="Increase">
                        +
                    </button>

                </div>
            </div>
        }
        else
        {
            <div class="mt-auto pt-3">
                <div class="alert alert-warning text-center mb-0">
                    <strong>No stock available</strong>
                </div>
            </div>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired]
    public SaleProduct Product { get; set; } = default!;
    private string? ValidationMessage;

    private decimal QuantityDelta;

    private string Step =>
        Product.AllowDecimalAsk
            ? "0.1"
            : "1";

    protected override void OnInitialized()
    {
        QuantityDelta = Cart.GetQuantityAsked(Product.Id);
    }

    private decimal Increment =>
        Product.AllowDecimalAsk
            ? 0.1m
            : 1m;

    private void Increase()
    {
        var lastQty = Cart.GetQuantityAsked(Product.Id);
        var newQuantity = lastQty + QuantityDelta;

        if(QuantityDelta <= 0)
        {
            return;
        }

        if (newQuantity > Product.Quantity)
        {
            ValidationMessage =
                $"Only {Product.Quantity} available in stock.";

            return;
        }

        ValidationMessage = null;
        Cart.SetQuantity(Product, newQuantity);
        ToastService.Success($"Added {QuantityDelta} {Product.Name} to cart");
    }

    private void Decrease()
    {
        var lastQty = Cart.GetQuantityAsked(Product.Id);
        var newQuantity = lastQty - QuantityDelta;

        if (QuantityDelta <= 0)
        {
            return;
        }

        if (newQuantity < 0)
        {
            newQuantity = 0;
        }
        Cart.SetQuantity(Product, newQuantity);
        ToastService.Info($"Removed {QuantityDelta} {Product.Name} from cart");
    }
}