@using Misstortas.Frontend.Services.Shared


@implements IDisposable
@inject IToastService ToastService


<div class="toast-container position-fixed top-0 end-0 p-3">

    @foreach (var toast in Toasts)
    {
        <div class="toast show mb-2 @toast.BackgroundClass">
            <div class="toast-header @toast.BackgroundClass">
                <strong class="me-auto @toast.TextClass">
                    @toast.Type
                </strong>

                <button type="button"
                        class="btn-close"
                        @onclick="() => DismissToast(toast)">
                </button>
            </div>

            <div class="toast-body @toast.TextClass">
                @toast.Message
            </div>
        </div>
    }

</div>

@code {
    // private string? Message;
    private CancellationTokenSource? cts;
    private readonly List<ToastMessage> Toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnToast += ShowToast;
    }
    private async void ShowToast(ToastMessage toast)
    {
        Toasts.Add(toast);

        await InvokeAsync(StateHasChanged);

        _ = RemoveLater(toast);
    }
    
    private async Task RemoveLater(ToastMessage toast)
    {
        await Task.Delay(toast.DurationMs);

        if (Toasts.Remove(toast))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        ToastService.OnToast -= ShowToast;
        cts?.Dispose();
    }
    private async Task DismissToast(ToastMessage toast)
    {
        if (Toasts.Remove(toast))
        {
            await InvokeAsync(StateHasChanged);
        }
    }
}