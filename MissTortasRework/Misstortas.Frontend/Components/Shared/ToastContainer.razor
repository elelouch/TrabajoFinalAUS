@using Misstortas.Frontend.Services.Shared

@implements IDisposable
@inject IToastService ToastService


<div class="toast-container-custom position-fixed top-0 end-0 p-3">

    @foreach (var toast in Toasts)
    {
        <div class="toast-custom show mb-2 @GetToastClass(toast)">
            <div class="toast-custom-header">
                <span class="toast-custom-icon">@GetToastIcon(toast)</span>
                <strong class="toast-custom-title">
                    @toast.Type
                </strong>

                <button type="button"
                        class="toast-custom-close"
                        aria-label="Cerrar"
                        @onclick="() => DismissToast(toast)">
                    &times;
                </button>
            </div>

            <div class="toast-custom-body">
                @toast.Message
            </div>
        </div>
    }

</div>

@code {
    // private string? Message;
    private CancellationTokenSource? cts;
    private readonly List<ToastMessage> Toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnToast += ShowToast;
    }
    private async void ShowToast(ToastMessage toast)
    {
        Toasts.Add(toast);

        await InvokeAsync(StateHasChanged);

        _ = RemoveLater(toast);
    }

    private async Task RemoveLater(ToastMessage toast)
    {
        await Task.Delay(toast.DurationMs);

        if (Toasts.Remove(toast))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        ToastService.OnToast -= ShowToast;
        cts?.Dispose();
    }
    private async Task DismissToast(ToastMessage toast)
    {
        if (Toasts.Remove(toast))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetToastClass(ToastMessage toast)
    {
        return toast.Type.ToString() switch
        {
            "Success" => "toast-custom-success",
            "Error" => "toast-custom-error",
            "Warning" => "toast-custom-warning",
            "Info" => "toast-custom-info",
            _ => "toast-custom-info",
        };
    }

    private static string GetToastIcon(ToastMessage toast)
    {
        return toast.Type.ToString() switch
        {
            "Success" => "✔",
            "Error" => "✖",
            "Warning" => "⚠",
            "Info" => "ℹ",
            _ => "ℹ",
        };
    }
}