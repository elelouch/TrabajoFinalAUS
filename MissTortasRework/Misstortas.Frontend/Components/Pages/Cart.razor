@using Microsoft.AspNetCore.Components.Server
@using Misstortas.Frontend.Services.Products
@using Misstortas.Frontend.Services.Order
@using Misstortas.Frontend.Components.Checkout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@rendermode @(new InteractiveServerRenderMode(prerender: false))


@page "/cart"

@implements IDisposable

@inject ISaleProductCartService CartService
@inject IOrderService OrderService
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Shopping Cart</h3>
@if (!CartService.Items.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in CartService.Items)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@item.QuantityAsked</td>
                    <td>$@item.Product.SalePrice</td>
                    <td>$@(item.QuantityAsked * (decimal)item.Product.SalePrice)</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Remove(item.Product.Id)">
                            Remove
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h5>Total: $@CartService.TotalPrice</h5>

    @if (!showCheckout)
    {
        <AuthorizeView>
            <Authorized>
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                    </div>
                }
                <button class="btn btn-primary mt-3" @onclick="ShowCheckout">
                    Pay Order
                </button>
            </Authorized>
            <NotAuthorized>
                <a href="/signin" class="btn btn-primary mt-3">
                    Sign In to Pay
                </a>
            </NotAuthorized>
        </AuthorizeView>
    }
    else
    {
        <Checkout OrderId="createdOrderId" OnPaymentSuccess="HandlePaymentSuccess" />
    }
}

@code
{
    private bool showCheckout = false;
    private long createdOrderId = 0;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        CartService.StateChanged += OnCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CartService.LoadAsync();
        }
    }

    private void OnCartChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Remove(long productId)
    {
        await CartService.Remove(productId);
    }

    private async Task ShowCheckout()
    {
        errorMessage = null;
        showCheckout = false;

        try
        {
            createdOrderId = await OrderService.PostCartAsync();
            showCheckout = true;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            // Log ex if you have a logger.
            errorMessage = "Something went wrong while creating your order. Please try again.";
        }
    }

    private async Task HandlePaymentSuccess()
    {
        await CartService.Clear();
        showCheckout = false;
    }

    public void Dispose()
    {
        CartService.StateChanged -= OnCartChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}