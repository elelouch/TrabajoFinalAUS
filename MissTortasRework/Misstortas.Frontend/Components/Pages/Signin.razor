@page "/signin"
@using Misstortas.Frontend.Services.Auth
@inject NavigationManager Navigation
@inject IAuthService AuthClient
@rendermode InteractiveServer

<div class="signin-wrapper">
    <div class="signin-card">
        <h3 class="signin-title">Bienvenido a MissTortas!</h3>

        <EditForm Model="userSignin" OnValidSubmit="HandleSubmit" FormName="signInForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Usuario o Correo</label>
                <InputText class="form-control"
                           @bind-Value="userSignin.Email" />
            </div>

            <div class="mb-3">
                <label>Contraseña</label>
                <InputText type="password"
                           class="form-control"
                           @bind-Value="userSignin.Password" />
            </div>

            <button type="submit"
                    class="btn btn-signin w-100"
                    disabled="@isLoading">
                @(isLoading ? "Ingresando..." : "Ingrese")
            </button>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="text-danger mt-2">@errorMessage</p>
            }

        </EditForm>
    </div>
</div>

@code {
    private UserSignin userSignin = new();

    private bool isLoading;

    private string? errorMessage;

    private async Task HandleSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var responseDTO = await AuthClient.SignInUserAsync(userSignin);
            Navigation.NavigateTo($"/postlogin?Token={responseDTO.AccessToken}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}