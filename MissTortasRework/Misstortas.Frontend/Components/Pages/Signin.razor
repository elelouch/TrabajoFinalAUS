@page "/signin"
@using Misstortas.Frontend.Services.Auth
@inject NavigationManager Navigation
@inject IAuthClient AuthClient
@rendermode InteractiveServer

<EditForm Model="userSignin" OnValidSubmit="HandleSubmit" FormName="signInForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control"
                   @bind-Value="userSignin.Email" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText type="password"
                   class="form-control"
                   @bind-Value="userSignin.Password" />
    </div>

    <button type="submit"
            class="btn btn-primary"
            disabled="@isLoading">
        @(isLoading ? "Signing in..." : "Sign In")
    </button>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="text-danger mt-2">@errorMessage</p>
    }

</EditForm>

@code {
    private UserSignin userSignin = new();

    private bool isLoading;

    private string? errorMessage;

    private async Task HandleSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            await AuthClient.SignInUserAsync(userSignin);
            // Optional:
            // Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}