@page "/signin"
@using Misstortas.Frontend.Services.Auth
@inject NavigationManager Navigation
@inject IAuthService AuthClient
@rendermode InteractiveServer

<div class="signin-wrapper">
    <div class="signin-card">
        <h3 class="signin-title">Bienvenido a MissTortas!</h3>

        <EditForm Model="userSignin" OnValidSubmit="HandleSubmit" FormName="signInForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Usuario o Correo</label>
                <InputText class="form-control signin-input"
                           @bind-Value="userSignin.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <InputText type="password"
                           class="form-control signin-input"
                           @bind-Value="userSignin.Password" />
            </div>

            <button type="submit"
                    class="btn signin-btn signin-btn-primary w-100 mt-2"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Ingrese</span>
                }
            </button>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="signin-error mt-2">@errorMessage</p>
            }

        </EditForm>

        <p class="signin-signup-link">
            ¿No tenés cuenta? <a href="/signup">Registrate</a>
        </p>
    </div>
</div>

@code {
    private UserSignin userSignin = new();

    private bool isLoading;

    private string? errorMessage;

    private async Task HandleSubmit()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var responseDTO = await AuthClient.SignInUserAsync(userSignin);
            Navigation.NavigateTo($"/postlogin?Token={responseDTO.AccessToken}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}