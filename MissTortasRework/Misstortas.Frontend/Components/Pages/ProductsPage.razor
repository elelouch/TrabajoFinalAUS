@using Misstortas.Frontend.Components.Categories
@using Misstortas.Frontend.Services.Products
@using Misstortas.Frontend.Models
@using Misstortas.Frontend.Components.Products
@using Microsoft.Extensions.Options

@inject IOptions<APIHostsOptions> APIHostsOptions
@inject IProductsService ProductsService
@inject ISaleProductCartService Cart

@rendermode InteractiveServer
@page "/products"

<h3 class="mb-3">Categories</h3>

@if (categories is null)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}
else
{
    <div class="row">
        <div class="col-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        @foreach (var cat in categories)
                        {
                            <CategoryNode Category="cat"
                                          OnFinalCategorySelected="LoadProducts" />
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-8">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Products</h5>
                    <ProductsGrid Products="saleProducts"></ProductsGrid>
                </div>
            </div>
        </div>

    </div>
}

@code {
    private List<Category>? categories;
    private SaleProduct[]? saleProducts;
    protected override async Task OnInitializedAsync()
    {
        categories = (await ProductsService.GetCategoriesAsync()).ToList();   
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await Cart.LoadAsync();
        }
    }

    private async Task LoadProducts(long categoryId)
    {
        saleProducts = await ProductsService.GetSaleProductsAsync(categoryId);
    }

}